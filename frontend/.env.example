# Copy this file to .env.local and fill in real values.

# ── Supabase — email + password auth (https://supabase.com/dashboard) ────────
# Found under Project Settings → API. When left blank, auth is disabled and the
# dashboard stays open (demo mode); the /login page shows a "not configured" note.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Public site URL ──────────────────────────────────────────────────────────
# Production URL used for social previews (Open Graph / Twitter cards), the
# sitemap and robots.txt. When blank, falls back to Vercel's production domain
# (VERCEL_PROJECT_PRODUCTION_URL), then http://localhost:3000.
NEXT_PUBLIC_SITE_URL=
